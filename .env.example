# DigiKI Homepage - Umgebungsvariablen
# Kopiere diese Datei als .env.local und trage die echten Werte ein.
# Die Werte findest du im Supabase-Dashboard unter: Settings → API

# ---------------------------------------------------------------------------
# Supabase (erforderlich für den Best-Practice-Bereich und Bestandsaufnahme)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# ---------------------------------------------------------------------------
# Basis-URL der Website (wird für JSON-LD / SEO-Metadaten verwendet)
# Lokal: http://localhost:3000  |  Produktion: https://www.digiki-osnabrueck.de
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
