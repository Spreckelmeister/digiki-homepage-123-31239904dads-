# DigiKI Homepage - Umgebungsvariablen
# Kopiere diese Datei als .env.local und trage die echten Werte ein.

# ---------------------------------------------------------------------------
# Supabase (erforderlich für den Best-Practice-Bereich und Bestandsaufnahme)
# Werte im Supabase-Dashboard unter: Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key
# Service Role Key – NUR serverseitig verwenden! Niemals im Browser/Client exponieren.
# Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# ---------------------------------------------------------------------------
# Basis-URL der Website (für JSON-LD, Passwort-Reset-Links)
# Lokal: http://localhost:3000  |  Produktion: https://digiki-os.de
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SMTP – Bestätigungs-E-Mails (Resend)
# API Key im Resend-Dashboard unter API Keys erstellen.
# Absenderdomain mail.digiki-os.de muss in Resend verifiziert sein (DNS).
# Wird genutzt für: Bestandsaufnahme-Bestätigung, Antrags-Mails, etc.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=re_xxx_dein-resend-api-key
SMTP_FROM=noreply@mail.digiki-os.de

# Kontaktformular: neue Anfragen zusätzlich per Mail weiterleiten.
# Wird normalerweise im Admin-Tab „Kontakt" gepflegt (Tabelle app_settings,
# Migration 035); diese Variable ist nur der Fallback ohne DB-Eintrag.
CONTACT_FORWARD_TO=

# ---------------------------------------------------------------------------
# SMTP – eigener Server für Klassenverteilungs-Mails UND das Admin-Mail-Tool
# (Rundmails) – Checkdomain o. ä.
# BEWUSST GETRENNT vom Resend-Setup oben, damit Eltern-Mails und
# Rundmails das Resend-Kontingent NICHT belasten (Resend bleibt für
# Login-Codes & Systemmails).
# Wird in /api/klassenbildung/{notify-local, session/[id]/notify} als
# Fallback genutzt, wenn die Lehrkraft keinen eigenen Schul-SMTP
# hinterlegt hat, und in /api/admin/mailings/send für alle Rundmails.
# ---------------------------------------------------------------------------
KV_SMTP_HOST=smtp.checkdomain.de
KV_SMTP_PORT=587
KV_SMTP_SECURE=false
KV_SMTP_USER=postmaster@dein-checkdomain-konto
KV_SMTP_PASSWORD=dein-checkdomain-passwort
KV_SMTP_FROM=klassenverteilung@deine-domain.de
