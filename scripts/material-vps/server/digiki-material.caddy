# DigiKI-Schulungsmaterial (große HTML-Lerneinheiten, in Einheiten aufgeteilt).
# Gehört zur DigiKI-Seite (www.digiki-os.de), nicht zu mentoki – eigene Ordner:
#   /srv/digiki/material/dateien   Material, von außen nicht direkt erreichbar
#   /var/log/digiki-material       Protokoll der Abrufe (je Konto, ohne IP)
# Quelle: Repo digiki-homepage, scripts/material-vps/server (einrichten.sh).
material.digiki-os.de {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Jeder Abruf braucht einen Link, der für ein Konto ausgestellt ist und
	# abläuft. Geprüft und mitgeschrieben wird er vom Dienst
	# digiki-material-pruefung; der nennt bei Erfolg die echte Datei.
	@material path_regexp ^/k/[a-z0-9-]+/[0-9a-f]{32}-[0-9]{10}-[0-9a-f]{40}/(index\.html|einheiten/[0-9a-z-]+\.html)$
	handle @material {
		# route: feste Reihenfolge – erst prüfen, dann auf die echte Datei umschreiben.
		route {
		forward_auth 127.0.0.1:8793 {
			uri /pruefen
			copy_headers X-Material-Datei X-Material-Konto
		}

		# Die Dateien stammen von Dritten und enthalten Skripte. „sandbox" ohne
		# allow-same-origin: eigener, leerer Ursprung, kein Zugriff auf die
		# umgebende Seite. default-src 'none': nichts aus dem Netz, nichts ins
		# Netz – nur was in der Datei steckt (data:, blob:) und die Einheiten
		# desselben Materials im Rahmen. Entspricht der Regel in
		# src/app/schulungsmaterial/inhalt/[id]/route.ts der DigiKI-Seite.
		#
		# Startseite: darf nur von der DigiKI-Seite eingebettet werden.
		# Einheiten: ohne frame-ancestors – die abgeschottete Startseite, die sie
		# einbettet, hat einen leeren Ursprung, den keine solche Regel benennen kann.
		@start path */index.html
		header @start Content-Security-Policy "sandbox allow-scripts allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox; default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' blob: data:; style-src 'unsafe-inline' blob:; img-src data: blob:; media-src data: blob:; font-src data: blob:; connect-src data: blob:; frame-src blob: https://material.digiki-os.de; worker-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors https://www.digiki-os.de https://digiki-os.de"
		@einheit path */einheiten/*
		header @einheit Content-Security-Policy "sandbox allow-scripts allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox; default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' blob: data:; style-src 'unsafe-inline' blob:; img-src data: blob:; media-src data: blob:; font-src data: blob:; connect-src data: blob:; frame-src blob: https://material.digiki-os.de; worker-src blob:; base-uri 'none'; form-action 'none'"
		# Jede Antwort gilt nur für ein Konto (eingesetzte Kennung) und der Link
		# wechselt täglich: Der Browser darf sie sechs Stunden behalten.
		header Cache-Control "private, max-age=21600"

		root * /srv/digiki/material/dateien
		rewrite * {http.request.header.X-Material-Datei}
		# Konto-Kennung einsetzen: Die Dateien enthalten dafür Platzhalter mit
		# eigenen Begrenzern (kurs-aufteilen.mjs), sonst nichts, was Caddy deutet.
		templates {
			between "<<DIGIKI{" "}>>"
			mime text/html
		}
		file_server
		}
	}

	handle {
		respond "Nicht gefunden." 404
	}
}
